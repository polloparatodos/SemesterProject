# Copy to terraform.tfvars and fill in.
# terraform.tfvars is gitignored — never commit it.

aws_region       = "us-east-1"
allowed_ssh_cidr = "203.0.113.5/32" # your public IP, /32

# Optional overrides (uncomment to change):
# instance_type    = "t3.large"
# public_key_path  = "~/.ssh/id_ed25519.pub"
# git_branch       = "master"
# app_profile      = "dev"

google_api_key = "" # required by agent-catalog-service
