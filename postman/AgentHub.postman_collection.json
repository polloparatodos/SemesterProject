              "raw": "{\n  \"name\": \"Research Assistant Agent\",\n  \"description\": \"Summarizes research papers and extracts key findings.\",\n  \"version\": \"1.0.0\",\n  \"agentType\": \"RESEARCH\",\n  \"provider\": \"OpenAI\",\n  \"status\": \"ACTIVE\"\n}"
